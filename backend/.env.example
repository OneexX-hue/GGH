DATABASE_URL="postgresql://carclub:carclub@localhost:5432/carclub?schema=public"
JWT_SECRET="change-me-in-production"
PORT=3001

# Rocket.Chat интеграция (chat-bridge) — опционально, при отсутствии backend
# работает в режиме no-op provisioning (не блокирует регистрацию/логин).
# ROCKETCHAT_ADMIN_TOKEN/ROCKETCHAT_ADMIN_USER_ID — Personal Access Token
# админ-аккаунта RC (Administration → Users → ваш admin → Personal Access
# Tokens), создаётся вручную после первого запуска (setup wizard).
ROCKETCHAT_BASE_URL=
ROCKETCHAT_WS_URL=
ROCKETCHAT_ADMIN_TOKEN=
ROCKETCHAT_ADMIN_USER_ID=
# Должен совпадать со значением CREATE_TOKENS_FOR_USERS_SECRET на самом
# сервере Rocket.Chat (Administration → General → REST API, либо env var) —
# без этого POST /chat-bridge/session (users.createToken) не работает.
CREATE_TOKENS_FOR_USERS_SECRET=

# Медиа в чате (backend/src/media) — собственное хранилище, см. docs/DECISIONS.md.
MEDIA_STORAGE_DIR=./storage-data
MEDIA_ENCRYPTION_KEY="change-me-in-production"

# MEDIA_STORAGE_DRIVER=s3 включает S3-совместимый адаптер (AWS S3, MinIO,
# Yandex Object Storage — любой провайдер с S3 API через endpoint) вместо
# локальной ФС. По умолчанию (не задано) — local.
MEDIA_STORAGE_DRIVER=local
S3_ENDPOINT=
S3_REGION=us-east-1
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=

# Сторонний платный API распознавания номеров (backend/src/modules/lpr),
# см. docs/DECISIONS.md, "LPR — бюджетный путь". Без ключа модуль отвечает
# понятной ошибкой конфигурации вместо распознавания.
LPR_API_KEY=

# Кросс-модульный дайджест в чат (backend/src/modules-registry/digest.service.ts)
# — раз в час постит сводку событий по всем модулям в указанную комнату
# Rocket.Chat. Без переменной — таймер не запускается вообще (не крутится
# вхолостую).
DIGEST_ROOM_ID=

# Push при новых сообщениях чата (исходящий вебхук Rocket.Chat, см. README
# для шагов ручной настройки в админке RC) — общий секрет, который RC
# передаёт в теле запроса, а backend сверяет перед обработкой.
CHAT_MESSAGE_WEBHOOK_SECRET=

# Масштабирование сигнализации звонков на несколько backend-инстансов
# (backend/src/calls/calls-presence.service.ts, docs/DECISIONS.md) —
# Valkey (Redis-протокол-совместимый, BSD-3-Clause — см. docs/LICENSING.md
# почему не сам Redis), поднимается через infra/docker-compose.yml.
# Опционально: без переменной CallsGateway работает в режиме одного
# backend-инстанса (presence только in-memory), не требует Valkey для
# локальной разработки.
VALKEY_URL=
