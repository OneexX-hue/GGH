# Скопировать в infra/.env и заполнить реальными значениями перед
# продакшен-деплоем — см. docs/deploy/timeweb-ubuntu-guide.md.
# docker-compose.prod.yml читает этот файл автоматически (стандартное
# поведение docker compose для файла .env рядом с compose-файлом).
#
# Секреты — не просто "любая строка", а криптографически случайные
# значения. Сгенерировать: openssl rand -hex 32

# Домены — DNS A-записи должны указывать на публичный IP этого сервера
# ДО запуска (Caddy получает TLS-сертификаты Let's Encrypt автоматически
# при первом старте, но только если DNS уже резолвится).
DOMAIN=carclub.example.com
ADMIN_DOMAIN=admin.carclub.example.com
API_DOMAIN=api.carclub.example.com
CHAT_DOMAIN=chat.carclub.example.com

# Postgres
POSTGRES_PASSWORD=

# Backend — основные секреты
JWT_SECRET=
MEDIA_ENCRYPTION_KEY=
CREATE_TOKENS_FOR_USERS_SECRET=
CHAT_MESSAGE_WEBHOOK_SECRET=

# Rocket.Chat admin — оставить пустыми при первом запуске, заполнить
# ПОСЛЕ прохождения setup wizard (шаг 7 гайда), затем перезапустить
# backend (docker compose -f docker-compose.prod.yml up -d backend).
ROCKETCHAT_ADMIN_TOKEN=
ROCKETCHAT_ADMIN_USER_ID=

# TURN (coturn) — статический пароль для WebRTC-звонков
TURN_PASSWORD=

# Хранилище медиа — local (диск контейнера, по умолчанию) или s3
# (рекомендуется для прода — Timeweb Cloud Object Storage S3-совместимо,
# точные endpoint/регион/бакет взять в личном кабинете Timeweb перед
# заполнением, см. docs/DECISIONS.md, "Хостинг").
MEDIA_STORAGE_DRIVER=local
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=

# Опционально
LPR_API_KEY=
DIGEST_ROOM_ID=
